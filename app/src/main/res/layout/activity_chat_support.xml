<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A1A1A"
        app:title="Chat de Soporte"
        app:titleTextColor="#FFFFFF" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/txtSlideToCancel"
        android:layout_below="@id/toolbarChat"
        android:padding="8dp" />

    <TextView
        android:id="@+id/txtSlideToCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/txtBlocked"
        android:background="#44000000"
        android:gravity="center"
        android:padding="4dp"
        android:text="← Desliza para cancelar"
        android:textColor="#FF9800"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtBlocked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layoutInput"
        android:background="#CC0000"
        android:gravity="center"
        android:padding="8dp"
        android:text="Has sido bloqueado del soporte"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1A1A1A"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_attach"
            app:tint="#FFFFFF" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Escribe un mensaje..."
            android:minHeight="48dp"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send"
            app:tint="#0084FF" />

        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_orange_circle"
            android:src="@drawable/ic_mic"
            app:tint="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
