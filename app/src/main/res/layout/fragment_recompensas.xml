<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F0F0F"
    tools:context=".Fragmentos.FragmentRecompensas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header con gradiente -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_gradient"
            android:padding="24dp">

            <!-- Título -->
            <TextView
                android:id="@+id/tvTituloRecompensas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIS RECOMPENSAS"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_alignParentTop="true"/>

            <!-- Nivel del usuario -->
            <LinearLayout
                android:id="@+id/layoutNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTituloRecompensas"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/star_big_on"
                    android:tint="#FFD700"/>

                <TextView
                    android:id="@+id/tvNivelUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nivel Oro"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <!-- Puntos actuales -->
            <LinearLayout
                android:id="@+id/layoutPuntos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutNivel"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="#2A2A2A"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Puntos Disponibles"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvPuntosActuales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1,250"
                    android:textColor="#FFD700"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <!-- Barra de progreso -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Siguiente nivel: Platino"
                            android:textColor="#CCCCCC"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvPuntosRestantes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="750 pts más"
                            android:textColor="#FFD700"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBarNivel"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:progress="62"
                        android:progressTint="#FFD700"
                        android:progressBackgroundTint="#444444"/>

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <!-- Tarjeta QR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CÓDIGO DE MIEMBRO"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <!-- Contenedor del QR -->
                <RelativeLayout
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/qr_border"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivCodigoQR"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_gallery"/>

                </RelativeLayout>

                <!-- Información del usuario -->
                <TextView
                    android:id="@+id/tvNombreUsuarioQR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Juan Pérez"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/tvCodigoUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEM-123456"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvMiembroDesde"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Miembro desde: Enero 2024"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>

                <!-- Botón para compartir QR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompartirQR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compartir QR"
                    android:textColor="#000000"
                    android:backgroundTint="#FFD700"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="#000000"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Sección de Recompensas Disponibles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎁 Recompensas Disponibles"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        </LinearLayout>

        <!-- Cómo ganar puntos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 ¿Cómo ganar puntos?"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compra boletos y gana 100 puntos"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍿"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compra en dulcería y gana 50 puntos"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎂"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recibe 500 puntos en tu cumpleaños"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>