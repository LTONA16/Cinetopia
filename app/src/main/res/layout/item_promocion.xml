<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="180dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <RelativeLayout
        android:id="@+id/layoutPromocion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF6B6B"
        android:padding="20dp">

        <!-- Imagen de fondo decorativa -->
        <ImageView
            android:id="@+id/ivPromocionFondo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloPromocion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡MARTES DE PLAZA!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"/>

            <TextView
                android:id="@+id/tvDescripcionPromocion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2x1 en combos"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>

            <TextView
                android:id="@+id/tvDescuentoPromocion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50% OFF"
                android:textColor="#FFD700"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"/>

        </LinearLayout>

        <!-- Botón flotante -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabVerPromocion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#000000"
            app:backgroundTint="#FFFFFF"
            app:fabSize="mini"/>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>