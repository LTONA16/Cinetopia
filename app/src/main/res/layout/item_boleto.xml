<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header con estado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFD700"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvEstadoBoleto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRÓXIMO"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/tvCodigoBoleto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOL-12345"
                android:textColor="#000000"
                android:textSize="10sp"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Poster de la película -->
            <ImageView
                android:id="@+id/ivPosterBoleto"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/p1"
                android:background="@drawable/rounded_corners"/>

            <!-- Información del boleto -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPeliculaBoleto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batman"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#FFD700"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        android:tint="#FFD700"/>

                    <TextView
                        android:id="@+id/tvCineBoleto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cinépolis VIP"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:layout_marginStart="6dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_today"
                        android:tint="#FFD700"/>

                    <TextView
                        android:id="@+id/tvFechaBoleto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18 Feb 2026"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:layout_marginStart="6dp"/>

                    <TextView
                        android:id="@+id/tvHoraBoleto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19:30"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:tint="#FFD700"/>

                    <TextView
                        android:id="@+id/tvSalaAsientosBoleto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sala 3 • F5, F6"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:layout_marginStart="6dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalBoleto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$350.00 MXN"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Línea punteada -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginHorizontal="16dp"/>

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerQR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver QR"
                android:textColor="#FFFFFF"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalles"
                android:textColor="#FFD700"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="8dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>