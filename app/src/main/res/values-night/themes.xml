<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Cinetopia" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores existentes -->
        <item name="colorPrimary">@color/orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/black</item>
        <item name="android:windowBackground">@color/white</item>

        <!-- 1. Color de fondo del FAB (por defecto usa primaryContainer) -->
        <item name="colorPrimaryContainer">@color/orange</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- 2. Color del "Pill" (el óvalo morado) al seleccionar en el BottomNav -->
        <item name="colorSecondaryContainer">@color/blue</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

</resources>